            "url": "https://he.wikipedia.org/wiki/%D7%99%D7%97%D7%99%D7%90%D7%9C_%D7%99%D7%94%D7%95%D7%A9%D7%A2_%D7%A8%D7%91%D7%99%D7%A0%D7%95%D7%91%D7%99%D7%A5",
